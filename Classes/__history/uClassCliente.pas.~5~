unit uClassCliente;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.Menus, Vcl.ExtCtrls,
  System.IniFiles, Data.DB,
  FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async,
  FireDAC.Phys, FireDAC.Phys.FB, FireDAC.Phys.FBDef, FireDAC.VCLUI.Wait,
  FireDAC.Comp.Client, FireDAC.Comp.UI, FireDAC.Phys.IBBase;

type
  TCliente = Class
    private
      ConexaoDB: TFDConnection;
      F_ID: Integer;
      F_Nome: String;
      F_Endereco: String;
      F_Cidade: String;
      F_Bairro: String;
      F_Estado: String;
      F_CEP: String;
      F_Telefone: String;
      F_Email: String;
      F_DataNascimento: TDateTime;

    public
      constructor Create(aConexaoDB: TFDConnection);
      destructor  Destroy; override;
      function Inserir: Boolean;
      function Atualizar: Boolean;
      function Excluir: Boolean;
      function Selecionar(ID: Integer): Boolean;
    published
      property Codigo: Integer            read F_ID write F_ID;
      property Nome: String               read F_Nome write F_Nome;
      property Endereco: String           read F_Endereco write F_Endereco;
      property Cidade: String             read F_Cidade write F_Cidade;
      property Bairro: String             read F_Bairro write F_Bairro;
      property Estado: String             read F_Estado write F_Estado;
      property CEP: String                read F_CEP write F_CEP;
      property Telefone: String           read F_Telefone write F_Telefone;
      property Email: String              read F_Email write F_Email;
      property DataNascimento: TDateTime  read F_DataNascimento write F_DataNascimento;
  end;

implementation
{ TCliente }

{$region 'Constructor and Destructor'}
constructor TCliente.Create(aConexaoDB: TFDConnection);
begin
  ConexaoDB := aConexaoDB;
end;

destructor TCliente.Destroy;
begin

  inherited;
end;
{$endregion}

{$region 'CRUD'}
function TCliente.Atualizar: Boolean;
var
  qry: TFDQuery;
begin
  qry := TFDQuery.Create(nil);
  try
    qry.Connection := ConexaoDB;
    qry.SQL.Clear;
    qry.SQL.Add('UPDATE CLIENTES');
    qry.SQL.Add('    SET NOME = (:pNOME)');
    qry.SQL.Add('        ,ENDERECO = (:pENDERECO)');
    qry.SQL.Add('        ,CIDADE = (:pCIDADE)');
    qry.SQL.Add('        ,BAIRRO = (:pBAIRRO)');
    qry.SQL.Add('        ,ESTADO = (:pESTADO)');
    qry.SQL.Add('        ,CEP = (:pCEP)');
    qry.SQL.Add('        ,TELEFONE = (:pTELEFONE)');
    qry.SQL.Add('        ,EMAIL = (:pEMAIL)');
    qry.SQL.Add('        ,DATANASCIMENTO = (:pDATANASCIMENTO)');
    qry.SQL.Add('    WHERE ID = (:pClienteID)');

    qry.ParamByName('pNOME').Value := Self.F_Nome;
    qry.ParamByName('pENDERECO').Value := Self.F_Endereco;
    qry.ParamByName('pCIDADE').Value := Self.F_Cidade;
    qry.ParamByName('pBAIRRO').Value := Self.F_Bairro;
    qry.ParamByName('pESTADO').Value := Self.F_Estado;
    qry.ParamByName('pCEP').Value := Self.F_CEP;
    qry.ParamByName('pTELEFONE').Value := Self.F_Telefone;
    qry.ParamByName('pEMAIL').Value := Self.F_Email;
    qry.ParamByName('pDATANASCIMENTO').Value := Self.F_DataNascimento;

    qry.ParamByName('pClienteID').Value := Self.F_ID;
    try
      qry.ExecSQL();

      Result := True;
    except
      Result := False;
    end;
  finally
    if Assigned(qry) then
      FreeAndNil(qry);
  end;
end;

function TCliente.Excluir: Boolean;
var
  qry: TFDQuery;
begin
  if MessageDlg('Apagar o Registro: '+ #13+
                'Código: '+IntToStr(Self.F_ID) + #13+
                'Nome: '+Self.F_Nome, mtConfirmation,[mbYes,mbNo], 0) = mrNo then
    begin
      Result := False;
      Abort;
    end;

  qry := TFDQuery.Create(nil);
  try
    qry.Connection := ConexaoDB;
    qry.SQL.Clear;
    qry.SQL.Add('DELETE FROM CLIENTES');
    qry.SQL.Add('    WHERE ID = (:pClienteID)');
    qry.ParamByName('pClienteID').Value := Self.F_ID;
    try
      qry.ExecSQL();

      Result := True;
    except
      Result := False;
    end;
  finally
    if Assigned(qry) then
      FreeAndNil(qry);
  end;
end;

function TCliente.Inserir: Boolean;
var
  qryInserir: TFDQuery;
begin
  qryInserir := TFDQuery.Create(nil);
  try
    qryInserir.Connection := ConexaoDB;
    qryInserir.SQL.Clear;
    qryInserir.SQL.Add('INSERT INTO CLIENTES (NOME, ENDERECO, CIDADE, BAIRRO, ESTADO, CEP, TELEFONE, EMAIL, DATANASCIMENTO)');
    qryInserir.SQL.Add('       VALUES (:pNOME, :pENDERECO, :pCIDADE, :pBAIRRO, :pESTADO, :pCEP, :pTELEFONE, :pEMAIL, :pDATANASCIMENTO)');

    qryInserir.ParamByName('pNOME').AsString := Self.F_Nome;
    qryInserir.ParamByName('pENDERECO').AsString := Self.F_Endereco;
    qryInserir.ParamByName('pCIDADE').AsString := Self.F_Cidade;
    qryInserir.ParamByName('pBAIRRO').AsString := Self.F_Bairro;
    qryInserir.ParamByName('pESTADO').AsString := Self.F_Estado;
    qryInserir.ParamByName('pCEP').AsString := Self.F_CEP;
    qryInserir.ParamByName('pTELEFONE').AsString := Self.F_Telefone;
    qryInserir.ParamByName('pEMAIL').AsString := Self.F_Email;
    qryInserir.ParamByName('pDATANASCIMENTO').AsDateTime := Self.F_DataNascimento;

    try
      qryInserir.ExecSQL;
      Result := True;
    except
      Result := False;
    end;
  finally
    if Assigned(qryInserir) then
      FreeAndNil(qryInserir);
  end;
end;

function TCliente.Selecionar(ID: Integer): Boolean;
var
  qry: TFDQuery;
begin
  qry := TFDQuery.Create(nil);
  try
    qry.Connection := ConexaoDB;
    qry.SQL.Clear;
    qry.SQL.Add('SELECT IID, NOME, ENDERECO, CIDADE, BAIRRO, ESTADO, CEP, TELEFONE, EMAIL, DATANASCIMENTO');
    qry.SQL.Add('   FROM CLIENTES');
    qry.SQL.Add(' WHERE ID = (:pClienteID)');
    qry.ParamByName('pClienteID').Value := ID;

    try
      qry.Open();

      Self.F_ID := qry.FieldByName('ID').AsInteger;
      Self.F_Nome := qry.FieldByName('NOME').AsString;
      Self.F_Endereco := qry.FieldByName('ENDERECO').AsString;
      Self.F_Cidade := qry.FieldByName('CIDADE').AsString;
      Self.F_Bairro := qry.FieldByName('BAIRRO').AsString;
      Self.F_Estado := qry.FieldByName('ESTADO').AsString;
      Self.F_CEP := qry.FieldByName('CEP').AsString;
      Self.F_Telefone := qry.FieldByName('TELEFONE').AsString;
      Self.F_Email := qry.FieldByName('EMAIL').AsString;
      Self.F_DataNascimento := qry.FieldByName('DATANASCIMENTO').AsDateTime;

      Result := True;
    except
      Result := False;
    end;
  finally
    if Assigned(qry) then
      FreeAndNil(qry);
  end;
end;
{$endregion}






end.
